datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  name         String
  role         String          @default("STUDENT") // STUDENT, ADMIN
  avatarUrl    String?
  mobileNumber String?
  emailVerified Boolean         @default(false)
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt    DateTime        @default(now())
  profile      StudentProfile?
  attempts     TestAttempt[]
  performances TopicPerformance[]
  mistakes     MistakeBookEntry[]
  studyPlans   StudyPlan[]
  notifications Notification[]
  achievements Achievement[]
  createdHomeworks Homework[] @relation("TeacherHomeworks")
  homeworkSubmissions HomeworkSubmission[] @relation("StudentHomeworkSubmissions")
  evaluatedSubmissions HomeworkSubmission[] @relation("TeacherEvaluatedSubmissions")
  createdStudyMaterials StudyMaterial[] @relation("TeacherStudyMaterials")
  studyMaterialAccesses StudyMaterialAccess[] @relation("StudentStudyMaterialAccesses")
  createdVideoLectures VideoLecture[] @relation("TeacherVideoLectures")
  videoLectureAccesses VideoLectureAccess[] @relation("StudentVideoLectureAccesses")
  createdTextbooks     TextbookDocument[] @relation("TeacherTextbookDocuments")
  remedialSessions     RemedialSession[]
}

model StudentProfile {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  standard             String    @default("Standard 8") // Standard 6, Standard 7, Standard 8
  rollNumber           String?
  mobileNumber         String?
  udiseCode            String?
  availableHoursPerDay Float     @default(2.5)
  examDate             DateTime?
  targetPercentage     Float     @default(85.0)
  streakCount          Int       @default(1)
  lastActiveDate       DateTime  @default(now())
}

model Subject {
  id          String    @id @default(uuid())
  name        String    @unique
  nameGu      String?
  code        String    @unique
  standard    String    @default("Standard 8") // Standard 6, Standard 7, Standard 8
  icon        String    @default("book")
  description String?
  descriptionGu String?
  createdAt   DateTime  @default(now())
  chapters    Chapter[]
  tests       Test[]
  homeworks   Homework[]
  studyMaterials StudyMaterial[]
  videoLectures VideoLecture[]
  remedialSessions RemedialSession[]
}

model Chapter {
  id        String   @id @default(uuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  nameGu    String?
  order     Int      @default(1)
  createdAt DateTime @default(now())
  topics    Topic[]
  homeworks Homework[]
  studyMaterials StudyMaterial[]
  videoLectures VideoLecture[]
  remedialSessions RemedialSession[]
}

model Topic {
  id          String             @id @default(uuid())
  chapterId   String
  chapter     Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name        String
  nameGu      String?
  description String?
  descriptionGu String?
  createdAt   DateTime           @default(now())
  questions   Question[]
  performances TopicPerformance[]
  mistakes    MistakeBookEntry[]
  studyTasks  StudyTask[]
  homeworks   Homework[]
  studyMaterials StudyMaterial[]
  videoLectures VideoLecture[]
}

model Question {
  id           String           @id @default(uuid())
  topicId      String
  topic        Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionText String
  questionTextGu String?
  explanation  String?
  explanationGu String?
  difficulty   String           @default("MEDIUM") // EASY, MEDIUM, HARD
  createdAt    DateTime         @default(now())
  options      QuestionOption[]
  testQuestions TestQuestion[]
  studentAnswers StudentAnswer[]
  mistakes     MistakeBookEntry[]
  remedialAnswers RemedialSessionAnswer[]
}

model QuestionOption {
  id         String          @id @default(uuid())
  questionId String
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String
  optionTextGu String?
  isCorrect  Boolean         @default(false)
  studentAnswers StudentAnswer[]
  remedialAnswers RemedialSessionAnswer[]
}

model Test {
  id              String         @id @default(uuid())
  title           String
  titleGu         String?
  description     String?
  descriptionGu   String?
  subjectId       String
  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  difficulty      String         @default("MEDIUM") // BASIC, MEDIUM, ADVANCED, CHALLENGE, REVISION
  durationMinutes Int            @default(30)
  passPercentage  Float          @default(60.0)
  createdAt       DateTime       @default(now())
  testQuestions   TestQuestion[]
  attempts        TestAttempt[]
}

model TestQuestion {
  id         String   @id @default(uuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(1)
}

model TestAttempt {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId           String
  test             Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  score            Float
  maxScore         Float
  percentage       Float
  accuracy         Float
  timeTakenSeconds Int
  correctCount     Int
  wrongCount       Int
  unansweredCount  Int
  completedAt      DateTime        @default(now())
  studentAnswers   StudentAnswer[]
}

model StudentAnswer {
  id               String          @id @default(uuid())
  attemptId        String
  attempt          TestAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  isCorrect        Boolean         @default(false)
  timeTakenSeconds Int             @default(0)
  mistakes         MistakeBookEntry[]
}

model TopicPerformance {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId                String
  topic                  Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  accuracy               Float    @default(0)
  attemptCount           Int      @default(0)
  repeatedMistakes       Int      @default(0)
  totalQuestionsAttempted Int     @default(0)
  totalCorrect           Int      @default(0)
  status                 String   @default("AVERAGE") // EXCELLENT, STRONG, AVERAGE, NEEDS_IMPROVEMENT, CRITICAL
  lastEvaluatedAt        DateTime @default(now())

  @@unique([userId, topicId])
}

model MistakeBookEntry {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswerId String?
  studentAnswer   StudentAnswer? @relation(fields: [studentAnswerId], references: [id], onDelete: SetNull)
  topicId         String
  topic           Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  incorrectCount  Int            @default(1)
  isResolved      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  lastAttemptedAt DateTime       @default(now())
}

model StudyPlan {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableMinutes Int         @default(150)
  examDate         DateTime?
  targetPercentage Float       @default(85.0)
  createdAt        DateTime    @default(now())
  tasks            StudyTask[]
}

model StudyTask {
  id              String    @id @default(uuid())
  planId          String
  plan            StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  topicId         String
  topic           Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subjectName     String
  topicName       String
  durationMinutes Int
  priority        String    @default("MEDIUM") // HIGH, MEDIUM, LOW
  activityType    String    @default("CONCEPT_REVIEW") // CONCEPT_REVIEW, MCQ_PRACTICE, MISTAKE_REVISION, FORMULA_DRILL, MOCK_QUIZ
  dayNumber       Int       @default(1) // 1 to 7 for weekly plan
  isCompleted     Boolean   @default(false)
  taskDate        DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  titleGu   String?
  message   String
  messageGu String?
  type      String   @default("INFO") // TEST, REVISION, STREAK, MISTAKE, ACHIEVEMENT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Achievement {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeName     String
  badgeNameGu   String?
  badgeIcon     String   @default("award")
  description   String
  descriptionGu String?
  unlockedAt    DateTime @default(now())
}

model Homework {
  id                 String               @id @default(uuid())
  title              String
  titleGu            String?
  instructions       String?
  instructionsGu     String?
  subjectId          String
  subject            Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId          String?
  chapter            Chapter?             @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topicId            String?
  topic              Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  standard           String               @default("Standard 8") // Standard 6, Standard 7, Standard 8, or ALL
  teacherId          String
  teacher            User                 @relation("TeacherHomeworks", fields: [teacherId], references: [id], onDelete: Cascade)
  assignedDate       DateTime             @default(now())
  dueDate            DateTime
  maxMarks           Float                @default(20.0)
  allowResubmission  Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  submissions        HomeworkSubmission[]
}

model HomeworkSubmission {
  id                 String                      @id @default(uuid())
  homeworkId         String
  homework           Homework                    @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId          String
  student            User                        @relation("StudentHomeworkSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  pdfFilePath        String
  originalFileName   String
  fileSizeBytes      Int?
  mimeType           String                      @default("application/pdf")
  status             String                      @default("PENDING") // PENDING, SUBMITTED, LATE, CHECKED
  submittedAt        DateTime?
  marksObtained      Float?
  teacherFeedback    String?
  evaluatedAt        DateTime?
  evaluatedBy        String?
  evaluator          User?                       @relation("TeacherEvaluatedSubmissions", fields: [evaluatedBy], references: [id], onDelete: SetNull)
  submissionVersion  Int                         @default(1)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  history            HomeworkSubmissionHistory[]

  @@unique([homeworkId, studentId])
}

model HomeworkSubmissionHistory {
  id               String             @id @default(uuid())
  submissionId     String
  submission       HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  pdfFilePath      String
  originalFileName String
  fileSizeBytes    Int?
  submittedAt      DateTime           @default(now())
  version          Int
  marksObtained    Float?
  teacherFeedback  String?
}

model StudyMaterial {
  id               String                @id @default(uuid())
  title            String
  titleGu          String?
  description      String?
  descriptionGu    String?
  subjectId        String
  subject          Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId        String?
  chapter          Chapter?              @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topicId          String?
  topic            Topic?                @relation(fields: [topicId], references: [id], onDelete: SetNull)
  standard         String                @default("Standard 8") // Standard 6, Standard 7, Standard 8, or ALL
  teacherId        String
  teacher          User                  @relation("TeacherStudyMaterials", fields: [teacherId], references: [id], onDelete: Cascade)
  pdfFilePath      String?
  pdfFileName      String?
  fileSizeBytes    Int?
  mimeType         String?               @default("application/pdf")
  videoTitle       String?
  videoUrl         String?
  status           String                @default("DRAFT") // DRAFT, PUBLISHED, UNPUBLISHED
  viewsCount       Int                   @default(0)
  downloadsCount   Int                   @default(0)
  videoClicksCount Int                   @default(0)
  publishedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  accesses         StudyMaterialAccess[]
}

model StudyMaterialAccess {
  id         String        @id @default(uuid())
  materialId String
  material   StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  studentId  String
  student    User          @relation("StudentStudyMaterialAccesses", fields: [studentId], references: [id], onDelete: Cascade)
  eventType  String        // VIEW, PDF_VIEW, PDF_DOWNLOAD, VIDEO_CLICK, STUDIED
  createdAt  DateTime      @default(now())

  @@index([materialId, studentId])
}

model VideoLecture {
  id               String               @id @default(uuid())
  title            String
  titleGu          String?
  description      String?
  descriptionGu    String?
  subjectId        String
  subject          Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId        String?
  chapter          Chapter?             @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topicId          String?
  topic            Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  standard         String               @default("Standard 8") // Standard 6, Standard 7, Standard 8, or ALL
  teacherId        String
  teacher          User                 @relation("TeacherVideoLectures", fields: [teacherId], references: [id], onDelete: Cascade)
  videoFilePath    String
  videoFileName    String
  fileSizeBytes    Int?
  durationSeconds  Int?                 @default(0)
  mimeType         String               @default("video/mp4")
  status           String               @default("PUBLISHED") // PUBLISHED, DRAFT
  viewsCount       Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  accesses         VideoLectureAccess[]
}

model VideoLectureAccess {
  id                   String       @id @default(uuid())
  lectureId            String
  lecture              VideoLecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  studentId            String
  student              User         @relation("StudentVideoLectureAccesses", fields: [studentId], references: [id], onDelete: Cascade)
  watchDurationSeconds Int          @default(0)
  lastWatchedAt        DateTime     @default(now())
  createdAt            DateTime     @default(now())

  @@index([lectureId, studentId])
}

model TextbookDocument {
  id            String          @id @default(uuid())
  title         String
  titleGu       String?
  board         String          // NCERT, GSEB
  standard      String          // Standard 6, Standard 7, Standard 8
  subject       String          // Science, Mathematics, Social Science, Gujarati, English, etc.
  medium        String          @default("English") // English, Gujarati
  academicYear  String          @default("2025-2026")
  chapterNumber Int?
  chapterName   String?
  pdfFilePath   String?
  fileSizeBytes Int?
  uploaderId    String?
  uploader      User?           @relation("TeacherTextbookDocuments", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  chunks        TextbookChunk[]

  @@index([board, standard, subject])
}

model TextbookChunk {
  id          String           @id @default(uuid())
  documentId  String
  document    TextbookDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  content     String
  pageNumber  Int              @default(1)
  chapterName String?
  topicName   String?
  vectorJson  String?          // Semantic vector embedding array (JSON string)
  keywords    String?
  createdAt   DateTime         @default(now())

  @@index([documentId])
}

model RemedialSession {
  id                    String                   @id @default(uuid())
  userId                String
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testAttemptId         String?
  testId                String?
  subjectId             String
  subject               Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId             String
  chapter               Chapter                  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  weakTopicsSummary     String?                  // JSON array of weak topic names or IDs
  initialPercentage     Float                    // Score % that triggered remedial (<50%)
  status                String                   @default("PENDING_REVISION") // PENDING_REVISION, REVISION_COMPLETED, TEST_IN_PROGRESS, COMPLETED
  revisionNotes         String?                  // Key concepts / summary in markdown/text
  revisionNotesGu       String?                  // Gujarati key concepts / summary
  remedialScore         Float?
  remedialMaxScore      Float?
  remedialPercentage    Float?
  improvementPercentage Float?                   // remedialPercentage - initialPercentage
  encouragementMessage  String?
  encouragementMessageGu String?
  stillWeakTopics       String?                  // JSON array of topics student still missed
  timeTakenSeconds      Int?
  completedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  answers               RemedialSessionAnswer[]

  @@index([userId, status])
}

model RemedialSessionAnswer {
  id               String          @id @default(uuid())
  sessionId        String
  session          RemedialSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  isCorrect        Boolean         @default(false)
}



