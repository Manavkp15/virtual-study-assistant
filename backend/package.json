{
  "name": "virtual-study-assistant-backend",
  "version": "1.0.0",
  "description": "Backend API for Virtual Study Assistant",
  "main": "dist/index.js",
  "scripts": {
    "prisma:prepare": "node scripts/prepare-prisma.js",
    "db:init": "node scripts/init-db.js",
    "build": "npm run prisma:prepare && tsc",
    "start": "node scripts/init-db.js && node dist/index.js",
    "dev": "ts-node src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
