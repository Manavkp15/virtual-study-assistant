# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (Render PostgreSQL or local SQLite)
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@dpg-xxxx.render.com/vsa_db?sslmode=require
# Local SQLite fallback:
DATABASE_URL=file:./dev.db

# Authentication Secret (Generate a strong random 32+ char secret in production)
JWT_SECRET=your_super_secret_jwt_key_replace_in_production_min_32_chars

# CORS Origin (Optional if running as a unified service; set if frontend is separate)
# FRONTEND_URL=https://virtual-study-assistant.onrender.com

# Optional AI API Key (Leave empty to use built-in heuristic analytics engine)
GEMINI_API_KEY=

# Optional SMTP Email Configuration (e.g. Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password
# EMAIL_FROM="VM જ્ઞાનસેતુ" <your_email@gmail.com>
